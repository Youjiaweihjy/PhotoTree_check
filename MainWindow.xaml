<Window x:Class="图像索引.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图像索引与批量管理" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部操作区 -->
            <RowDefinition Height="*"/>
            <!-- 主体展示区 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部操作区 -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- 第一行：设置与路径配置 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <!-- 新增的设置按钮 -->
                    <Button Content="⚙️ 设置" Click="BtnSettings_Click" Padding="10,2" Margin="0,0,15,0" Background="#E0E0E0" Cursor="Hand"/>

                    <TextBlock Text="读取路径 (源):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtSourcePath" Width="200" Margin="0,0,5,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#FFF"/>
                    <Button Content="浏览..." Click="BtnBrowseSource_Click" Padding="10,2" Margin="0,0,20,0" Cursor="Hand"/>

                    <TextBlock Text="导出路径 (目标):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtDestPath" Width="200" Margin="0,0,5,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#FFF"/>
                    <Button Content="浏览..." Click="BtnBrowseDest_Click" Padding="10,2" Cursor="Hand"/>
                </StackPanel>

                <!-- 第二行：关键字搜索与导出操作 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文件关键字:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtKeyword" Width="150" Margin="0,0,15,0" VerticalContentAlignment="Center" Background="#FFF"/>

                    <Button Content="批量导出并归类" Click="BtnExport_Click" Padding="15,5" Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主体展示区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- 左侧文件树 -->
                <ColumnDefinition Width="*"/>
                <!-- 右侧大图 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：动态文件树 (懒加载) -->
            <TreeView x:Name="DirTree" Grid.Column="0" Margin="5" SelectedItemChanged="DirTree_SelectedItemChanged">
                <!-- 这里不需要 ItemTemplate，因为我们在后台代码是直接操作 TreeViewItem 的 -->
            </TreeView>

            <!-- 右侧：预览区 -->
            <Border Grid.Column="1" Background="#333" Margin="5">
                <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="请点击上方浏览按钮选择读取路径"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>